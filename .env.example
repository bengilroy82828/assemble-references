# Postgres connection string from Neon (use the "Pooled connection" string for Vercel)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ char random secret used to sign session cookies and referee tokens
# Generate one at https://generate-secret.vercel.app/32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"

# Verified sender address in Resend (must be on a domain you've verified with Resend)
EMAIL_FROM="Assemble Solutions <references@assemblesolutions.com.au>"

# Email address(es) that receive completed reference notifications.
# Comma-separate for multiple recipients.
ADMIN_NOTIFY_EMAIL="ben@assemblesolutions.com.au"

# Public base URL of the deployed app (no trailing slash). Used to build referee links.
NEXT_PUBLIC_APP_URL="https://references.assemblesolutions.com.au"

# Long random secret used to authenticate Vercel Cron requests.
# Generate at https://generate-secret.vercel.app/32 (different from AUTH_SECRET).
CRON_SECRET="another-long-random-string-at-least-32-chars"
